<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.effect.Blend?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="475.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.Calculate">
   <Label layoutX="160.0" layoutY="23.0" prefHeight="35.0" prefWidth="202.0" text="Калькулятор">
      <font>
         <Font size="24.0" />
      </font>
   </Label>
   <TextArea fx:id="area" layoutX="47.0" layoutY="84.0" nodeOrientation="LEFT_TO_RIGHT" prefHeight="195.0" prefWidth="200.0">
      <effect>
         <Blend />
      </effect>
   </TextArea>
   <Button fx:id="result" layoutX="297.0" layoutY="333.0" mnemonicParsing="false" onAction="#result_enter" prefHeight="25.0" prefWidth="51.0" text="=" />
   <Button fx:id="reset" layoutX="138.0" layoutY="333.0" mnemonicParsing="false" onAction="#reset_enter" text="Сброс" />
   <FlowPane layoutX="261.0" layoutY="90.0" prefHeight="195.0" prefWidth="210.0">
      <children>
         <Button fx:id="one" mnemonicParsing="false" onAction="#one_button" prefHeight="45.0" prefWidth="67.0" text="1" />
         <Button fx:id="two" mnemonicParsing="false" onAction="#two_button" prefHeight="45.0" prefWidth="67.0" text="2" />
         <Button fx:id="three" mnemonicParsing="false" onAction="#three_button" prefHeight="45.0" prefWidth="67.0" text="3" />
         <Button fx:id="foure" mnemonicParsing="false" onAction="#foure_button" prefHeight="45.0" prefWidth="67.0" text="4" />
         <Button fx:id="five" mnemonicParsing="false" onAction="#five_button" prefHeight="45.0" prefWidth="67.0" text="5" />
         <Button fx:id="six" mnemonicParsing="false" onAction="#six_button" prefHeight="45.0" prefWidth="67.0" text="6" />
         <Button fx:id="seven" mnemonicParsing="false" onAction="#seven_button" prefHeight="45.0" prefWidth="67.0" text="7" />
         <Button fx:id="eight" mnemonicParsing="false" onAction="#eight_button" prefHeight="45.0" prefWidth="67.0" text="8" />
         <Button fx:id="nine" mnemonicParsing="false" onAction="#nine_button" prefHeight="45.0" prefWidth="67.0" text="9" />
         <Button fx:id="addition" mnemonicParsing="false" onAction="#addition_button" prefHeight="45.0" prefWidth="35.0" text="+" />
         <Button fx:id="subtraction" mnemonicParsing="false" onAction="#subtraction_button" prefHeight="45.0" prefWidth="41.0" text="-" />
         <Button fx:id="multiplication" mnemonicParsing="false" onAction="#multiplication_button" prefHeight="44.0" prefWidth="35.0" text="*" />
         <Button fx:id="division" mnemonicParsing="false" onAction="#division_button" prefHeight="44.0" prefWidth="57.0" text="/" />
         <Button fx:id="point" mnemonicParsing="false" onAction="#point_button" prefHeight="44.0" prefWidth="31.0" text="." />
      </children>
   </FlowPane>
   <Button fx:id="Exit" layoutX="409.0" layoutY="14.0" mnemonicParsing="false" onAction="#exit_programm" text="Выход" />
</AnchorPane>
